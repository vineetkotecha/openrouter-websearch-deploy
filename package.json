{
  "name": "@divaine/search-harness",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Personalized search control plane for AI agents",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "divaine-search": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "eval:routing": "tsx src/eval/routing.ts",
    "benchmark": "node scripts/benchmark.mjs",
    "learn:report": "tsx src/learning/cli.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.19.1",
    "@typesafe-ai/sdk": "^0.6.0",
    "argon2": "^0.45.1",
    "fastify": "^5.6.1",
    "fastify-plugin": "^5.0.1",
    "pg": "^8.16.3",
    "pino": "^9.9.4",
    "prom-client": "^15.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  }
}
